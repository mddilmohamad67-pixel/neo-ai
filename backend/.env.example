# ── NEO AI backend ─────────────────────────────────────────────
# Copy to .env and fill. Never commit the real .env.

# Shared secret between the app and this server.
# Open NEO app > Settings > Connection and copy the generated token here.
NEO_TOKEN=PASTE_APP_TOKEN_HERE

# OpenAI (conversation + intent brain)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional compatible endpoint (e.g. a local proxy). Keep empty for OpenAI.
OPENAI_BASE_URL=

# ElevenLabs (natural female voice). Leave empty to use the phone's TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Network. Keep localhost unless you understand the LAN risks.
NEO_HOST=127.0.0.1
NEO_PORT=8787
NEO_RATE_PER_MIN=60

# Weather fallback when the phone grants no location permission.
NEO_DEFAULT_LAT=28.6139
NEO_DEFAULT_LON=77.2090
NEO_DEFAULT_CITY=New Delhi
