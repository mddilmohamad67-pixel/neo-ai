# ── NEO AI backend ─────────────────────────────────────────────
# Copy to .env and fill. Never commit the real .env.

# dev = local Termux, production = cloud/HTTPS hardening on.
NEO_ENV=dev

# Device access token (NOT an OpenAI key). Make it long:
#   python3 -c "import secrets;print(secrets.token_hex(32))"
# Put the same value in the app: Settings > Device access token.
NEO_TOKEN=

# Optional extra device tokens, comma separated (revoke one device without
# breaking the others): NEO_TOKENS=abc...,def...
NEO_TOKENS=

# production: refuse to start with a short/default token and require HTTPS
# (TLS is usually terminated by the host/proxy; keep NEO_REQUIRE_HTTPS=1).
NEO_REQUIRE_HTTPS=0

# Optional host allowlist (comma separated). Recommended in production.
NEO_ALLOWED_HOSTS=

# OpenAI (conversation + intent brain) — stays on the server only.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
# Optional compatible endpoint (e.g. a local proxy). Keep empty for OpenAI.
OPENAI_BASE_URL=

# ElevenLabs (natural female voice). Leave empty to use the phone's TTS.
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=
ELEVENLABS_MODEL=eleven_multilingual_v2

# Network. Local dev: 127.0.0.1. Docker/cloud: 0.0.0.0 (see Dockerfile).
NEO_HOST=127.0.0.1
NEO_PORT=8787
NEO_RATE_PER_MIN=60
# 0 = unlimited; otherwise per-device requests per day.
NEO_DAILY_REQUESTS=0
# Max request body in bytes (transcribe enforces 8 MB itself).
NEO_MAX_BODY=12582912

# Trust only your reverse proxy when it sets X-Forwarded-* headers.
NEO_FORWARDED_IPS=127.0.0.1

# Weather fallback when the phone grants no location permission.
NEO_DEFAULT_LAT=28.6139
NEO_DEFAULT_LON=77.2090
NEO_DEFAULT_CITY=New Delhi
